# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local Python installations
.venv/
venv/
env/
ENV/
__pypackages__/

# Test, type-checking, linting, and coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# The standalone subproject's lockfile, which this repository does not use.
# `subprojects/docket/` carries its own pyproject.toml, so `uv` run from inside
# it resolves and writes one - but the root pyproject.toml already declares
# those tests in `testpaths`, so they belong to the root environment and the
# root `uv.lock`. Anchored rather than a bare `uv.lock`, which would also match
# the tracked root lockfile (`PL-8PT6`).
/subprojects/docket/uv.lock

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
wheels/

# Flet runtime and local application state
/.flet/
/storage/
/uploads/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*~

# macOS metadata
.DS_Store
._*

# Editor state, and the two halves are not the same. `.idea/` is entirely
# local. `.vscode/` is not: `settings.json` is tracked project configuration -
# the interpreter path, pytest, and ruff as the format-on-save formatter - so
# the directory's *contents* are excluded and the shared files re-admitted by
# name. Form taken from `github/gitignore`'s
# `Global/VisualStudioCode.gitignore`, minus its `!*.code-workspace`, which
# negates an exclude this file does not have and so would read as if workspace
# files were ignored somewhere (`PL-RFGY`).
#
# `.vscode/*` rather than `.vscode/`, and the difference is the whole bug this
# replaced: git does not descend into an excluded *directory*, so every
# negation under a bare `.vscode/` is dead and `extensions.json` stayed
# unaddable while `settings.json` sat tracked beside it.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Claude Code personal overrides (project settings are committed)
.claude/settings.local.json
