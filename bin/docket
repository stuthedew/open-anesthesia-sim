#!/usr/bin/env bash
# Run the docket CLI from a checkout, with no install step and no virtualenv.
#
# This exists so the command is one stable, short string. The package lives in
# `subprojects/`, so invoking it directly means prefixing every call with a
# PYTHONPATH assignment - which is noise in a transcript, and does not match a
# tool-permission pattern, so every capture would stop for an approval prompt.
# Capture has to be frictionless to be used at all, so the wrapper absorbs it.
#
# Resolves the repository root from its own location, so it works from any
# working directory inside the checkout.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHONPATH="$root/subprojects/docket/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec python3 -m docket "$@"
